[Version]
Signature="$WINDOWS NT$"
Class=MEDIA
ClassGuid={4d36e96c-e325-11ce-bfc1-08002be10318}
Provider=%Provider%
CatalogFile=pujjo_audio.cat
DriverVer=11/23/2026,0.0.1.0
PnpLockdown=1

[Manufacturer]
%Provider%=Models,NTamd64.10.0...22000

[Models.NTamd64.10.0...22000]
%Device%=Dmic,PUJJO\AudioDmic

[DestinationDirs]
DriverFiles=13

[SourceDisksNames]
1=%Disk%,,,""

[SourceDisksFiles]
pujjo_audio.sys=1,,

[Dmic.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration,WDMAUDIO.Registration
CopyFiles=DriverFiles

[DriverFiles]
pujjo_audio.sys

[Dmic.NT.Services]
AddService=pujjo_audio,0x00000002,Service

[Service]
DisplayName=%Device%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\pujjo_audio.sys

[Dmic.NT.Interfaces]
AddInterface=%Audio%,DmicWave,WaveInterface
AddInterface=%Capture%,DmicWave,WaveInterface
AddInterface=%Realtime%,DmicWave,WaveInterface
AddInterface=%Audio%,DmicTopology,TopologyInterface
AddInterface=%Topology%,DmicTopology,TopologyInterface

[WaveInterface]
AddReg=WaveMetadata

[TopologyInterface]
AddReg=TopologyMetadata

[WaveMetadata]
HKR,,FriendlyName,,%Device%
HKR,,CLSID,,%Proxy%

[TopologyMetadata]
HKR,,FriendlyName,,%Device%
HKR,,CLSID,,%Proxy%

