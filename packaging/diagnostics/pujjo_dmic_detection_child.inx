; SPDX-License-Identifier: BSD-3-Clause
; Metadata-only DMIC detection test. Recording is always rejected.
; Requires a separately verified local test signature.
[Version]
Signature="$WINDOWS NT$"
Class=MEDIA
ClassGuid={4d36e96c-e325-11ce-bfc1-08002be10318}
Provider=%Provider%
CatalogFile=pujjo_audio_detection.cat
DriverVer=11/26/2026,0.0.8.1
PnpLockdown=1

[Manufacturer]
%Provider%=Models,NTamd64.10.0...22000

[Models.NTamd64.10.0...22000]
%Device%=Dmic,PUJJO\AudioDmicDetectionTest

[DestinationDirs]
DriverFiles=13

[SourceDisksNames]
1=%Disk%,,,""

[SourceDisksFiles]
pujjo_audio_detection.sys=1,,

[Dmic.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration,WDMAUDIO.Registration
CopyFiles=DriverFiles
AddReg=PinNameRegistration

[PinNameRegistration]
HKR,MediaCategories\%DetectionPinName%,Name,,%Device%

[DriverFiles]
pujjo_audio_detection.sys

[Dmic.NT.Services]
AddService=pujjo_audio_detection,0x00000002,Service

[Service]
DisplayName=%Device%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\pujjo_audio_detection.sys

[Dmic.NT.Interfaces]
AddInterface=%Audio%,DmicWave,WaveInterface
AddInterface=%Capture%,DmicWave,WaveInterface
AddInterface=%Realtime%,DmicWave,WaveInterface
AddInterface=%Audio%,DmicTopology,TopologyInterface
AddInterface=%Topology%,DmicTopology,TopologyInterface

[WaveInterface]
AddReg=WaveMetadata

[TopologyInterface]
AddReg=TopologyMetadata

[WaveMetadata]
HKR,,FriendlyName,,%Device%
HKR,,CLSID,,%Proxy%

[TopologyMetadata]
HKR,,FriendlyName,,%Device%
HKR,,CLSID,,%Proxy%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioDevice_NeverSetAsDefaultEndpoint%,0x00010001,0x00000307
HKR,EP\0,%PKEY_AudioEngine_OEMFormat%,0x00000001,41,00,00,00,28,00,00,00,fe,ff,04,00,80,bb,00,00,00,b8,0b,00,10,00,20,00,16,00,20,00,00,00,00,00,01,00,00,00,00,00,10,00,80,00,00,aa,00,38,9b,71

