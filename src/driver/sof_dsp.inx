;
; Copyright 2026 The SOF Authors
;
; Sound Open Firmware (SOF) Windows Driver Package
;

[Version]
Signature="$WINDOWS NT$"
Class=MEDIA
ClassGuid={4d36e96c-e325-11ce-bfc1-08002be10318}
Provider=%ProviderName%
CatalogFile=sof_dsp.cat
DriverVer=11/13/2026,0.0.1.0
PnpLockdown=1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
sof_dsp.sys = 1,,

; ================= Manufacturer & Models =================

[Manufacturer]
%MfgName% = Intel,NT$ARCH$.10.0...16299

[Intel.NT$ARCH$.10.0...16299]
; Pujjo/Pujjo1e ACPI + SMBIOS checks run inside the driver as well.
; SUBSYS_00000000 alone is not unique to Pujjo.
%Pujjo.DeviceDesc% = Sof_Device, PCI\VEN_8086&DEV_54C8&SUBSYS_00000000

; ================= Install Sections =================

[Sof_Device.NT]
CopyFiles = Drivers_Dir

[Drivers_Dir]
sof_dsp.sys

[Sof_Device.NT.Services]
AddService = sof_dsp,%SPSVCINST_ASSOCSERVICE%,Sof_Service_Inst

[Sof_Service_Inst]
DisplayName    = %Sof.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\sof_dsp.sys
AddReg         = Sof_Service_Inst.AddReg

[Sof_Service_Inst.AddReg]
HKR,Parameters,SafeBootPolicy,0x00010001,2
HKR,Parameters,BootSafetyToken,0x00010001,0
HKR,Parameters,ArmedTesting,0x00010001,0
HKR,Parameters,EnablePortCls,0x00010001,0
HKR,Parameters,EnableS0Idle,0x00010001,0
HKR,Parameters,S0IdleTimeoutMs,0x00010001,5000
HKR,Parameters,EnableUsbOffload,0x00010001,0

; ================= KMDF WDF Section =================

[Sof_Device.NT.Wdf]
KmdfService = sof_dsp, Sof_wdfsect

[Sof_wdfsect]
KmdfLibraryVersion = 1.35

; ================= Strings =================

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ProviderName = "Sound Open Firmware Project"
MfgName = "Sound Open Firmware"
DiskName = "SOF Driver Installation Disk"
Sof.SVCDESC = "Sound Open Firmware DSP Service"
Intel.DeviceDesc = "Intel Sound Open Firmware Audio DSP"
Pujjo.DeviceDesc = "Pujjo/Pujjo1e SOF Audio DSP (EXPERIMENTAL)"
Amd.DeviceDesc = "AMD Sound Open Firmware Audio DSP"
