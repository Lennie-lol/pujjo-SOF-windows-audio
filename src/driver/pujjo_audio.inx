[Version]
Signature="$WINDOWS NT$"
Class=MEDIA
ClassGuid={4d36e96c-e325-11ce-bfc1-08002be10318}
Provider=%Provider%
CatalogFile=pujjo_audio.cat
DriverVer=11/19/2026,0.0.1.0
PnpLockdown=1

[Manufacturer]
%Provider%=Models,NTamd64.10.0...22000

[Models.NTamd64.10.0...22000]
%Device%=Dmic,PUJJO\AudioDmic
%Headphone%=Headphone,PUJJO\AudioHeadphone
%HeadsetMic%=HeadsetMic,PUJJO\AudioHeadsetMic
%Speaker%=Speaker,PUJJO\AudioSpeaker

[DestinationDirs]
DriverFiles=13

[SourceDisksNames]
1=%Disk%

[SourceDisksFiles]
pujjo_audio.sys=1

[Dmic.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration,WDMAUDIO.Registration
CopyFiles=DriverFiles

[DriverFiles]
pujjo_audio.sys

[Headphone.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration,WDMAUDIO.Registration
CopyFiles=DriverFiles

[HeadsetMic.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration,WDMAUDIO.Registration
CopyFiles=DriverFiles

[Speaker.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration,WDMAUDIO.Registration
CopyFiles=DriverFiles

[Headphone.NT.Services]
AddService=pujjo_audio,0x00000002,Service

[HeadsetMic.NT.Services]
AddService=pujjo_audio,0x00000002,Service

[Speaker.NT.Services]
AddService=pujjo_audio,0x00000002,Service

[Dmic.NT.Services]
AddService=pujjo_audio,0x00000002,Service

[Service]
DisplayName=%Device%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\pujjo_audio.sys

[Dmic.NT.Interfaces]
AddInterface=%Audio%,DmicWave,WaveInterface
AddInterface=%Capture%,DmicWave,WaveInterface
AddInterface=%Realtime%,DmicWave,WaveInterface
AddInterface=%Audio%,DmicTopology,TopologyInterface
AddInterface=%Topology%,DmicTopology,TopologyInterface

[Headphone.NT.Interfaces]
AddInterface=%Audio%,HeadphoneWave,HeadphoneInterface
AddInterface=%Render%,HeadphoneWave,HeadphoneInterface
AddInterface=%Realtime%,HeadphoneWave,HeadphoneInterface
AddInterface=%Audio%,HeadphoneTopology,HeadphoneInterface
AddInterface=%Topology%,HeadphoneTopology,HeadphoneInterface

[HeadsetMic.NT.Interfaces]
AddInterface=%Audio%,HeadsetMicWave,HeadsetMicInterface
AddInterface=%Capture%,HeadsetMicWave,HeadsetMicInterface
AddInterface=%Realtime%,HeadsetMicWave,HeadsetMicInterface
AddInterface=%Audio%,HeadsetMicTopology,HeadsetMicInterface
AddInterface=%Topology%,HeadsetMicTopology,HeadsetMicInterface

[Speaker.NT.Interfaces]
AddInterface=%Audio%,SpeakerWave,SpeakerInterface
AddInterface=%Render%,SpeakerWave,SpeakerInterface
AddInterface=%Realtime%,SpeakerWave,SpeakerInterface
AddInterface=%Audio%,SpeakerTopology,SpeakerInterface
AddInterface=%Topology%,SpeakerTopology,SpeakerInterface

[HeadphoneInterface]
AddReg=HeadphoneMetadata

[HeadsetMicInterface]
AddReg=HeadsetMicMetadata

[SpeakerInterface]
AddReg=SpeakerMetadata

[HeadphoneMetadata]
HKR,,FriendlyName,,%Headphone%
HKR,,CLSID,,%Proxy%

[HeadsetMicMetadata]
HKR,,FriendlyName,,%HeadsetMic%
HKR,,CLSID,,%Proxy%

[SpeakerMetadata]
HKR,,FriendlyName,,%Speaker%
HKR,,CLSID,,%Proxy%

[WaveInterface]
AddReg=WaveMetadata

[TopologyInterface]
AddReg=TopologyMetadata

[WaveMetadata]
HKR,,FriendlyName,,%Device%
HKR,,CLSID,,%Proxy%

[TopologyMetadata]
HKR,,FriendlyName,,%Device%
HKR,,CLSID,,%Proxy%

[Strings]
Provider="Sound Open Firmware"
Device="Pujjo Internal Microphone (Experimental)"
Headphone="Pujjo Headphone (Experimental)"
HeadsetMic="Pujjo Headset Microphone (Experimental)"
Speaker="Pujjo Internal Speaker (Experimental)"
